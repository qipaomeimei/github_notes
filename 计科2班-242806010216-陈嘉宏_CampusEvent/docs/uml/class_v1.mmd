classDiagram
    %% CampusEvent baseline-v1 UML 类图（可粘贴到 Mermaid Live Editor 渲染）
    class Student {
        -String id
        -String name
        -Role role
        -String passwordHash
        +isAdmin() Boolean
    }
    class Activity {
        -Integer id
        -String title
        -String category
        -String location
        -Integer capacity
        -PolicyType policyType
        -DateTime startAt
        +hasStarted(now) Boolean
        +remainingSeats(approvedCount) Integer
    }
    class Registration {
        -Integer id
        -Integer activityId
        -String studentId
        -RegistrationStatus status
        +isActive() Boolean
        +canCancel() Boolean
    }
    class Message {
        -Integer id
        -String studentId
        -Integer activityId
        -String content
        -Boolean isRead
    }
    class RegistrationPolicy {
        <<interface>>
        +decide(ctx) Decision
    }
    class DirectRegistrationPolicy {
        +decide(ctx) Decision
    }
    class ApprovalRegistrationPolicy {
        +decide(ctx) Decision
    }
    class PolicyFactory {
        -Map policies
        +create(type) RegistrationPolicy
        +register(policy) void
        +has(type) Boolean
    }
    class RegistrationService {
        +register(studentId, activityId)
        +cancel(registrationId, studentId)
        +approve(registrationId, adminId)
        +reject(registrationId, adminId)
        +myRegistrations(studentId)
    }
    class ActivityService {
        +create(input) Activity
        +update(id, input) Activity
        +delete(id) void
        +getStats(id) Stats
        +listApprovals() List
    }
    class AuthService {
        +login(account, password) Student
        +resolveSession(token) Student
    }
    class RegistrationEvent {
        -String id
        -RegistrationEventType type
        -String studentId
        -String status
        +occurredAt DateTime
    }
    class DomainEventBus {
        +subscribe(type, handler) void
        +publish(event) void
    }
    class NotificationService {
        +handle(event) void
        -deliver(event) void
    }
    class InAppNotificationChannel {
        +name String
        +send(event) void
    }
    class NotificationLogRepository {
        +has(eventId, channel) Boolean
        +record(eventId, channel, status, error)
    }

    Registration --> Activity : activityId
    Registration --> Student : studentId
    Message --> Student
    DirectRegistrationPolicy ..|> RegistrationPolicy
    ApprovalRegistrationPolicy ..|> RegistrationPolicy
    PolicyFactory ..> RegistrationPolicy : creates
    RegistrationService ..> RegistrationPolicy : uses
    RegistrationService ..> DomainEventBus : publish
    RegistrationService --> ActivityService
    NotificationService ..> RegistrationEvent : observes
    NotificationService --> InAppNotificationChannel
    NotificationService --> NotificationLogRepository
