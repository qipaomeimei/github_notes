@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
hide footbox
autonumber
title 初始版本：学生报名（直接报名 / 审核型报名）

actor "学生" as Student
participant "活动详情页" as UI
participant "RegistrationService" as Service
participant "ActivityRepository" as ActivityRepo
participant "RegistrationRepository" as RegRepo
participant "RegistrationPolicy" as Policy
participant "EventBus" as Bus
participant "SiteMessageHandler" as Handler
database "SQLite" as DB

Student -> UI : 提交报名
UI -> Service : register(activityId, studentId)

Service -> ActivityRepo : get(activityId)
ActivityRepo --> Service : Activity
Service -> Service : 校验：活动存在、未开始
Service -> RegRepo : findActive(activityId, studentId)
RegRepo --> Service : null / 已有有效报名
alt 已存在有效报名
  Service --> UI : BusinessError("请勿重复提交")
else 可以报名
  Service -> RegRepo : count(activityId, APPROVED)
  RegRepo --> Service : approvedCount
  Service -> Policy : decide(context)
  Policy --> Service : PolicyDecision

  alt 直接报名且名额充足
    Service -> RegRepo : create(..., APPROVED)
    RegRepo -> DB : INSERT registration
    RegRepo --> Service : Registration(APPROVED)
  else 审核型报名
    Service -> RegRepo : create(..., PENDING)
    RegRepo -> DB : INSERT registration
    RegRepo --> Service : Registration(PENDING)
  else 直接报名且名额已满
    Service --> UI : BusinessError("名额已满")
  end

  Service -> Service : 事务提交
  Service -> Bus : publish(RegistrationEvent)
  Bus -> Bus : reserve(eventId) 幂等检查
  Bus -> Handler : handle(event)
  Handler -> DB : INSERT message
  Service --> UI : 报名结果
  UI --> Student : 展示状态与提示
end
@enduml

